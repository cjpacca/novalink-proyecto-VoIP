[sedes_internas]
; =========================================
; EXTENSIONES LOCALES (PREFIJO 1)
; =========================================

; Extensión 1001 - Habilitamos Transferencia ('t' y 'T')
exten => 1001,1,Dial(PJSIP/1001,30,tT)
exten => 1001,n,Hangup()

; Extensión 1002 - Habilitamos Transferencia ('t' y 'T')
exten => 1002,1,Dial(PJSIP/1002,30,tT)
exten => 1002,n,Hangup()

; =========================================
; SERVICIOS PBX EMPRESARIALES
; =========================================

; 1. Sala de Conferencia (Marcando 1099)
exten => 1099,1,Answer()
exten => 1099,n,Playback(conf-getpin)
exten => 1099,n,ConfBridge(sala_novalink)
exten => 1099,n,Hangup()

; 2. Código de Prueba de Audio (Marcando 1111) - Echo Test
exten => 1111,1,Answer()
exten => 1111,n,Echo()
exten => 1111,n,Hangup()

; =========================================
; ENRUTAMIENTO EXTERNO (HACIA SEDE 2)
; =========================================
; Cualquier número de 4 dígitos que empiece con 2, se envía por la troncal
exten => _2XXX,1,Dial(PJSIP/${EXTEN}@trunk-sede2,30,tT)
exten => _2XXX,n,Hangup()

